{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run develop)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose -f docker-compose.dev.yaml config:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.dev)",
      "Read(./.env.prod)",
      "Read(./.env.production)"
    ]
  }
}
